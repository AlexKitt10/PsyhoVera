<script>
const OLLAMA_SERVER = 'http://62.109.8.203:11435';
const MODEL_NAME = 'deepseek-r1:latest';

const CONTENT_FILTER = {
  forbiddenWords: [
    'оскорбление', 'ненависть', 'угроза', 'экстремизм',
    'пропаганда', 'дискриминация', 'унижение', 'травля',
    'ненавижу', 'убью', 'уничтожу', 'ненавистный'
  ],

  forbiddenTopics: [
    'самоповреждение', 'суицид', 'насилие',
    'незаконные вещества', 'экстремизм', 'терроризм'
  ],
  
  minRussianRatio: 0.9
};

let recognition = null;
let isRecording = false;
let finalTranscript = '';

function checkVoiceInputSupport() {
  const voiceStatus = document.getElementById('voiceStatus');
  const voiceBtn = document.getElementById('voiceBtn');

  const isLocalFile = window.location.protocol === 'file:';
  const isHttp = window.location.protocol === 'http:' || window.location.protocol === 'https:';
  const isSecure = window.location.protocol === 'https:';
  
  if (isLocalFile) {

    if (voiceBtn) {
      voiceBtn.disabled = true;
      voiceBtn.title = 'Голосовой ввод не работает с локальными файлами';
      voiceBtn.style.opacity = '0.5';
    }
    if (voiceStatus) {
      voiceStatus.innerHTML = `
        <div class="voice-warning">
          <strong> Голосовой ввод не работает с локальных файлов</strong><br>
          <small>Для работы голосового ввода:</small><br>
          <small>1. Загрузите страницу на хостинг (например, GitHub Pages)</small><br>
          <small>2. Или используйте локальный сервер (например, Live Server в VS Code)</small>
        </div>
      `;
    }
    return false;
  }
  
  if (isHttp && !isSecure) {

    if (voiceStatus) {
      voiceStatus.innerHTML = `
        <div class="voice-warning">
          <strong> Голосовой ввод требует HTTPS</strong><br>
          <small>Для надежной работы голосового ввода используйте HTTPS</small>
        </div>
      `;
    }
  }
  

  const hasSpeechRecognition = 'webkitSpeechRecognition' in window || 'SpeechRecognition' in window;
  
  if (!hasSpeechRecognition) {
    console.warn('Голосовой ввод не поддерживается в этом браузере');
    if (voiceBtn) {
      voiceBtn.disabled = true;
      voiceBtn.title = 'Голосовой ввод не поддерживается';
      voiceBtn.style.opacity = '0.5';
    }
    if (voiceStatus) {
      voiceStatus.innerHTML = `
        <div class="voice-warning">
          <strong> Голосовой ввод не поддерживается вашим браузером</strong><br>
          <small>Используйте Chrome, Edge или Safari последних версий</small>
        </div>
      `;
    }
    return false;
  }
  
  return true;
}

function initVoiceRecognition() {
  if (!checkVoiceInputSupport()) {
    return;
  }
  
  const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
  recognition = new SpeechRecognition();
  
  recognition.continuous = true;
  recognition.interimResults = true;
  recognition.lang = 'ru-RU';
  
  recognition.onstart = function() {
    isRecording = true;
    const voiceBtn = document.getElementById('voiceBtn');
    const voiceStatus = document.getElementById('voiceStatus');
    if (voiceBtn) voiceBtn.classList.add('listening');
    if (voiceStatus) {
      voiceStatus.innerHTML = `
        <div style="color:#dc3545; font-weight:bold;">
          🎤 Слушаю... Говорите
        </div>
        <div class="voice-help">
          Нажмите в любое место на странице или клавишу ESC для остановки
        </div>
      `;
    }
    finalTranscript = '';
  };
  
  recognition.onresult = function(event) {
    let interimTranscript = '';
    
    for (let i = event.resultIndex; i < event.results.length; ++i) {
      if (event.results[i].isFinal) {
        finalTranscript += event.results[i][0].transcript;
      } else {
        interimTranscript += event.results[i][0].transcript;
      }
    }
    
    const chatInput = document.getElementById('chatInput');
    if (chatInput) {
      const currentText = chatInput.value;
      if (interimTranscript) {
        chatInput.value = currentText + (currentText ? ' ' : '') + (finalTranscript + interimTranscript);
      } else if (finalTranscript) {
        chatInput.value = currentText + (currentText ? ' ' : '') + finalTranscript;
      }
    }
  };
  
  recognition.onerror = function(event) {
    console.error('Ошибка распознавания голоса:', event.error);
    const voiceStatus = document.getElementById('voiceStatus');
    const voiceBtn = document.getElementById('voiceBtn');
    
    if (voiceStatus) {
      if (event.error === 'not-allowed') {
        voiceStatus.innerHTML = `
          <div class="voice-warning">
            <strong>Доступ к микрофону запрещен</strong><br>
            <small>Для использования голосового ввода:</small><br>
            <small>1. Нажмите на значок микрофона ещё раз</small><br>
            <small>2. Разрешите доступ к микрофону в появившемся окне</small><br>
            <small>3. Обновите страницу и попробуйте снова</small>
          </div>
        `;
      } else if (event.error === 'no-speech') {
        voiceStatus.innerHTML = `
          <div class="voice-warning">
            <strong> Речь не обнаружена</strong><br>
            <small>Говорите громче и ближе к микрофону</small>
          </div>
        `;
      } else if (event.error === 'audio-capture') {
        voiceStatus.innerHTML = `
          <div class="voice-warning">
            <strong>Не удалось получить доступ к микрофону</strong><br>
            <small>Проверьте подключение микрофона и настройки</small>
          </div>
        `;
      } else {
        voiceStatus.innerHTML = `
          <div class="voice-warning">
            <strong>Ошибка: ${event.error}</strong><br>
            <small>Попробуйте обновить страницу или использовать текстовый ввод</small>
          </div>
        `;
      }
    }
    
    stopVoiceRecognition();
  };
  
  recognition.onend = function() {
    stopVoiceRecognition();
    const voiceStatus = document.getElementById('voiceStatus');
    if (voiceStatus) {
      if (finalTranscript) {
        voiceStatus.innerHTML = `
          <div class="voice-help">
            Текст успешно распознан
          </div>
        `;
        setTimeout(() => {
          voiceStatus.innerHTML = '';
        }, 3000);
      } else {
        voiceStatus.innerHTML = '';
      }
    }
  };
}

function stopVoiceRecognition() {
  if (recognition && isRecording) {
    try {
      recognition.stop();
    } catch (e) {

    }
    isRecording = false;
    const voiceBtn = document.getElementById('voiceBtn');
    if (voiceBtn) voiceBtn.classList.remove('listening');
  }
}

function toggleVoiceRecognition() {
  const chatInput = document.getElementById('chatInput');
  const voiceBtn = document.getElementById('voiceBtn');
  const voiceStatus = document.getElementById('voiceStatus');

  if (isRecording) {
    stopVoiceRecognition();
    return;
  }
  

  if (!checkVoiceInputSupport()) {
    if (voiceStatus) {
      voiceStatus.innerHTML = `
        <div class="voice-warning">
          <strong> Голосовой ввод недоступен</strong><br>
          <small>Используйте текстовый ввод</small>
        </div>
      `;
    }
    return;
  }
  
  if (!recognition) {
    initVoiceRecognition();
  }
  
  if (voiceStatus) {
    voiceStatus.innerHTML = '';
  }
  
  try {
    recognition.start();
  } catch (error) {
    console.error('Ошибка при запуске распознавания:', error);
    if (voiceStatus) {
      voiceStatus.innerHTML = `
        <div class="voice-warning">
          <strong>Не удалось начать запись</strong><br>
          <small>${error.message || 'Неизвестная ошибка'}</small>
        </div>
      `;
    }
  }
}

function clearInput() {
  const chatInput = document.getElementById('chatInput');
  const chatResult = document.getElementById('chatResult');
  const voiceStatus = document.getElementById('voiceStatus');
  
  if (chatInput) chatInput.value = '';
  if (chatResult) chatResult.style.display = 'none';
  if (voiceStatus) voiceStatus.innerHTML = '';
  if (chatInput) chatInput.focus();
  
  if (isRecording) {
    stopVoiceRecognition();
  }
}


function isRussianText(text) {
  const cyrillicRegex = /[а-яА-ЯёЁ]/;
  const cyrillicCount = (text.match(/[а-яА-ЯёЁ]/g) || []).length;
  const totalLetters = (text.match(/[a-zA-Zа-яА-ЯёЁ]/g) || []).length;
  
  if (totalLetters === 0) return false;
  return (cyrillicCount / totalLetters) >= CONTENT_FILTER.minRussianRatio;
}


function checkForForbiddenContent(text) {
  const lowerText = text.toLowerCase();
  
  
  for (const word of CONTENT_FILTER.forbiddenWords) {
    if (lowerText.includes(word.toLowerCase())) {
      return {
        forbidden: true,
        reason: `Обнаружено запрещенное слово: "${word}"`,
        word: word
      };
    }
  }
  
  
  for (const topic of CONTENT_FILTER.forbiddenTopics) {
    if (lowerText.includes(topic.toLowerCase())) {
      return {
        forbidden: true,
        reason: `Запрещенная тема: "${topic}"`,
        topic: topic
      };
    }
  }
  
  return { forbidden: false };
}


function filterAIResponse(response) {
  let filteredResponse = response;
  
  
  const languagePatterns = [
    /^(English:|French:|German:|Spanish:|Italian:|中文:|日本語:)/i,
    /I'm sorry, I cannot/i,
    /As an AI assistant/i,
    /Ich kann nicht/i,
    /Je ne peux pas/i,
    /No puedo/i
  ];
  
  for (const pattern of languagePatterns) {
    if (pattern.test(filteredResponse)) {
      return "Пожалуйста, задайте вопрос на русском языке. Я могу отвечать только на русском.";
    }
  }
  
  
  const forbiddenPatterns = [
    /оскорбля/i,
    /ненавист/i,
    /убийств/i,
    /насили/i,
    /экстремист/i,
    /терроризм/i,
    /пропаганда/i,
    /самоубийств/i,
    /суицид/i
  ];
  
  for (const pattern of forbiddenPatterns) {
    if (pattern.test(filteredResponse.toLowerCase())) {
      return "Извините, я не могу ответить на этот вопрос. Пожалуйста, обратитесь к специалисту очно.";
    }
  }
  
  
  if (!isRussianText(filteredResponse)) {
    return "Пожалуйста, задайте вопрос на русском языке. Я могу отвечать только на русском.";
  }
  
  return filteredResponse;
}

async function sendToAI(prompt) {
  const chatResult = document.getElementById('chatResult');
  const sendBtn = document.getElementById('sendBtn');
  
  if (!sendBtn || !chatResult) {
    console.error('Не найдены элементы на странице');
    return;
  }
  
  
  const contentCheck = checkForForbiddenContent(prompt);
  if (contentCheck.forbidden) {
    chatResult.innerHTML = `
      <div class="result chat-error">
        <strong>Запрос содержит недопустимое содержание</strong><br>
        <p>${contentCheck.reason}</p>
        <p>Пожалуйста, сформулируйте ваш вопрос в уважительной и конструктивной форме.</p>
        <p>Запрещены: оскорбления, ненависть, дискриминация, экстремизм, угрозы.</p>
      </div>
    `;
    chatResult.style.display = 'block';
    return;
  }
  
  sendBtn.disabled = true;
  chatResult.innerHTML = '<div class="chat-loading"> Вера готовит ответ...</div>';
  chatResult.style.display = 'block';
  chatResult.className = 'result';
  
  try {
    const formattedPrompt = `[INST] 
Ты - квалифицированный психолог Вера. Отвечай ТОЛЬКО на русском языке.
Если вопрос задан на другом языке, переведи его и отвечай на русском.

ТВОИ ОБЯЗАТЕЛЬНЫЕ ПРАВИЛА:
0. Отвечай в фориате рекомендаций и практических пожеланий клиену по устранению его
1. Отвечай ТОЛЬКО на русском языке
2. Используй ТОЛЬКО кириллицу
3. Не используй английские или другие не-русские слова
4. Будь эмпатичным, поддерживающим и профессиональным
5. Избегай сложных психологических терминов
6. Не ставь диагнозы и не давай медицинских рекомендаций
7. Не предлагай опасных действий
8. Если вопрос вне твоей компетенции, вежливо откажись отвечать
9. Форматируй ответ с использованием абзацев для удобства чтения
10. Завершай ответ на позитивной ноте с поддержкой

Запрещено:
- Отвечать на других языках
- Давать медицинские или юридические консультации
- Рекомендовать что-либо опасное или незаконное
- Быть осуждающим или критикующим

Твой формат вывода: список рекомендаций и практических советов пользователю. Помоги ему справиться с трудностями, опираясь на знаниях в психологии и психотерапии.

Вопрос клиента: "${prompt}"

Ответь как психолог Вера (только на русском): [/INST]\n`;
    
    const payload = {
      model: MODEL_NAME,
      prompt: formattedPrompt,
      stream: false,
      options: { 
        temperature: 0.7,
        num_predict: 512,
        top_p: 0.9,
        repeat_penalty: 1.1,
        
        stop: ["English:", "French:", "German:", "Spanish:", "Italian:", 
               "I'm sorry", "As an AI", "Ich bin", "Je suis", "Yo soy",
               "Конец", "Вот и все", "На этом все"]
      }
    };
    
    console.log('Отправляю запрос на:', OLLAMA_SERVER);
    
    const response = await fetch(`${OLLAMA_SERVER}/api/generate`, {
      method: 'POST',
      headers: { 
        'Content-Type': 'application/json',
        'Accept': 'application/json'
      },
      mode: 'cors',
      body: JSON.stringify(payload)
    });
    
    if (!response.ok) {
      let errorText = '';
      try {
        errorText = await response.text();
      } catch (e) {
        errorText = 'Не удалось прочитать ошибку';
      }
      throw new Error(`HTTP ${response.status}: ${response.statusText}\n${errorText}`);
    }
    
    const data = await response.json();
    let answer = data.response || data.message?.content || 'Нет ответа от модели';
    
    
    answer = filterAIResponse(answer);
    
    
    const formattedAnswer = answer
      .replace(/\n/g, '<br>')
      .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
      .replace(/\*(.*?)\*/g, '<em>$1</em>');
    
    chatResult.innerHTML = `
      <div style="text-align: left;">
        <strong style="color: #4CAF50;"> Вера говорит:</strong>
        <div style="margin-top: 10px; line-height: 1.6; font-size: 16px;">${formattedAnswer}</div>
        <div style="margin-top: 15px; font-size: 12px; color: #666; border-top: 1px solid #eee; padding-top: 10px;">
         
        </div>
      </div>
    `;
    
  } catch (error) {
    console.error('Полная ошибка:', error);
    chatResult.className = 'result chat-error';
    
    let errorMessage = `
      <div style="color: #d32f2f;">
        <strong>Ошибка:</strong> ${error.message}
      </div>
      <div style="margin-top: 15px; font-size: 14px;">
        <strong>Проверьте:</strong>
        <ul>
          <li>Адрес сервера: ${OLLAMA_SERVER}</li>
          <li>Модель: ${MODEL_NAME}</li>
          <li>Сеть: может быть блокировка CORS</li>
        </ul>
        <button onclick="testConnection()" style="padding: 5px 10px; margin-top: 10px; background: #5fab26; color: white; border: none; border-radius: 3px; cursor: pointer;">
          Тест подключения
        </button>
      </div>
    `;
    
    chatResult.innerHTML = errorMessage;
  } finally {
    sendBtn.disabled = false;
  }
}

async function testConnection() {
  const testResult = document.getElementById('chatResult') || document.createElement('div');
  
  try {
    testResult.innerHTML = ' Проверяю подключение к серверу...';
    
    const response = await fetch(`${OLLAMA_SERVER}/api/tags`, {
      method: 'GET',
      headers: { 'Accept': 'application/json' }
    });
    
    if (response.ok) {
      const data = await response.json();
      const models = data.models?.map(m => m.name).join(', ') || 'нет моделей';
      testResult.innerHTML = `
        <div style="color: #4CAF50;">
          ✓ Сервер доступен!<br>
          <small>Доступные модели: ${models}</small><br>
          <small>Текущая модель: ${MODEL_NAME}</small>
        </div>
      `;
      return true;
    } else {
      testResult.innerHTML = `
        <div style="color: #d32f2f;">
          ✗ HTTP ошибка: ${response.status} ${response.statusText}
        </div>
      `;
      return false;
    }
  } catch (error) {
    testResult.innerHTML = `
      <div style="color: #d32f2f;">
        ✗ Ошибка сети: ${error.message}<br>
        <small>Проверьте:<br>
        1. Сервер ${OLLAMA_SERVER}<br>
        2. Порт 11434 открыт<br>
        3. Нет блокировки CORS<br>
        4. Сервер Ollama запущен</small>
      </div>
    `;
    return false;
  }
}


document.addEventListener('DOMContentLoaded', function() {
  console.log('Ollama клиент загружен');
  console.log('Сервер:', OLLAMA_SERVER);
  console.log('Модель:', MODEL_NAME);
  console.log('Фильтр контента:', CONTENT_FILTER);
  
  
  checkVoiceInputSupport();
  
  
  const chatForm = document.getElementById('chatForm');
  const voiceBtn = document.getElementById('voiceBtn');
  const clearBtn = document.getElementById('clearBtn');
  
  if (chatForm) {
    chatForm.addEventListener('submit', async function(e) {
      e.preventDefault();
      const promptInput = document.getElementById('chatInput');
      const prompt = promptInput ? promptInput.value.trim() : '';
      
      if (!prompt) {
        alert('Пожалуйста, введите ваш вопрос или описание ситуации');
        return;
      }
      
      if (prompt.length < 5) {
        alert('Пожалуйста, введите более развернутый вопрос (минимум 5 символов)');
        return;
      }
      
      await sendToAI(prompt);
      if (promptInput) promptInput.value = '';
      
      if (isRecording) {
        stopVoiceRecognition();
      }
    });
  }
  
  if (voiceBtn) {
    voiceBtn.addEventListener('click', toggleVoiceRecognition);
  }
  
  if (clearBtn) {
    clearBtn.addEventListener('click', clearInput);
  }
  
  
  setTimeout(testConnection, 1000);
  
  document.addEventListener('click', function(event) {
    const chatInput = document.getElementById('chatInput');
    const voiceBtn = document.getElementById('voiceBtn');
    
    if (isRecording && 
        event.target !== chatInput && 
        event.target !== voiceBtn && 
        !voiceBtn.contains(event.target)) {
      stopVoiceRecognition();
    }
  });
  
  document.addEventListener('keydown', function(event) {
    if (event.key === 'Escape' && isRecording) {
      stopVoiceRecognition();
    }
  });
});
